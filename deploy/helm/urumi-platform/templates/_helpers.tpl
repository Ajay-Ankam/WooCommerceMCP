{{/* Secret holding the Utility and Analytics bearer tokens (generated by the chart unless existingSecret is set). */}}
{{- define "urumi.mcpBusinessSecret" -}}
{{- .Values.mcpBusiness.auth.existingSecret | default (printf "%s-mcp-business-auth" .Release.Name) -}}
{{- end -}}

{{/* In-cluster URL of a Service in this release's namespace. Args: root context, service suffix, port. */}}
{{- define "urumi.serviceUrl" -}}
{{- $root := index . 0 -}}
{{- printf "http://%s-%s.%s.svc.cluster.local:%v/mcp" $root.Release.Name (index . 1) $root.Release.Namespace (index . 2) -}}
{{- end -}}

{{/*
Bundled MCP servers the gateway registers on every start, rendered as the
BUNDLED_SERVERS JSON. Secrets are referenced by environment variable name
only; their values are injected separately via secretKeyRef.
*/}}
{{- define "urumi.bundledServers" -}}
{{- $root := . -}}
{{- $servers := list -}}
{{- range $slug := list "woocommerce" "utility" "analytics" -}}
{{- $cfg := index $root.Values.gateway.bundledServers $slug -}}
{{- if $cfg.enabled -}}
{{- $url := $cfg.url -}}
{{- if not $url -}}
{{- if eq $slug "woocommerce" -}}
{{- $url = include "urumi.serviceUrl" (list $root "mcp-woocommerce" $root.Values.gateway.bundledServers.woocommerce.port) -}}
{{- else -}}
{{- $url = include "urumi.serviceUrl" (list $root (printf "mcp-%s" $slug) $root.Values.mcpBusiness.service.port) -}}
{{- end -}}
{{- end -}}
{{- $entry := dict "slug" $slug "name" $cfg.name "url" $url "authType" "bearer" "credentialEnv" (printf "BUNDLED_%s_TOKEN" (upper $slug)) "adminOnlyTools" ($cfg.adminOnlyTools | default list) -}}
{{- $servers = append $servers $entry -}}
{{- end -}}
{{- end -}}
{{- toJson $servers -}}
{{- end -}}

{{/* Secret name and key holding a bundled server's bearer token. */}}
{{- define "urumi.bundledCredential" -}}
{{- $root := index . 0 -}}
{{- $slug := index . 1 -}}
{{- $cfg := index $root.Values.gateway.bundledServers $slug -}}
{{- $name := $cfg.credential.secretName | default (include "urumi.mcpBusinessSecret" $root) -}}
{{- printf "%s|%s" $name $cfg.credential.key -}}
{{- end -}}
