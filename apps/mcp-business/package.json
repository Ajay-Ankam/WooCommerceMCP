{
  "name": "mcp-business",
  "version": "1.0.0",
  "private": true,
  "description": "Utility and Sales Analytics MCP servers for the AJAY gateway",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "dev:utility": "tsx src/utility/main.ts",
    "dev:analytics": "tsx src/analytics/main.ts",
    "start:utility": "node dist/utility/main.js",
    "start:analytics": "node dist/analytics/main.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
