# Copy to .env for local development. Never commit .env.
# In Kubernetes these values come from Secrets, not files.

# Chat agent LLM providers (tried in order; a provider without a key is skipped)
LLM_PROVIDERS=gemini,groq
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
LLM_TIMEOUT_MS=60000
CHAT_TIMEZONE=Asia/Kolkata
